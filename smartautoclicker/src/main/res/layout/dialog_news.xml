<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margin_horizontal_large"
        android:paddingEnd="@dimen/margin_horizontal_large"
        android:paddingTop="@dimen/margin_vertical_large"
        android:paddingBottom="@dimen/margin_vertical_large">

        <LinearLayout
            android:id="@+id/update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_vertical_large"
            android:orientation="vertical"
            android:padding="@dimen/margin_horizontal_small"
            android:background="@drawable/background_news_update"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/update_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColor="@color/badge"
                android:textSize="@dimen/text_size_list_item_text"
                tools:text="Version 1.7.0 is available"/>

            <TextView
                android:id="@+id/update_notes"
                style="@style/LibraryInfoValue"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/margin_vertical_small"
                tools:text="Notes of the new version"/>

            <Button
                android:id="@+id/btn_update"
                style="@style/Widget.AppCompat.Button.Borderless.Colored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="@string/dialog_news_update_download"/>
        </LinearLayout>

        <TextView
            android:id="@+id/changes"
            style="@style/LibraryInfoValue"
            android:layout_width="match_parent"
            android:lineSpacingExtra="2dp"
            tools:text="Features"/>
    </LinearLayout>
</ScrollView>
