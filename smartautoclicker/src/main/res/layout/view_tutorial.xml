<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <com.buzbuz.smartautoclicker.activity.news.TutorialSpotlightView
        android:id="@+id/spotlight"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/margin_horizontal_large"
        android:layout_marginEnd="@dimen/margin_horizontal_large"
        android:orientation="vertical"
        android:paddingStart="@dimen/margin_horizontal_default"
        android:paddingEnd="@dimen/margin_horizontal_small"
        android:paddingTop="@dimen/margin_vertical_large"
        android:background="@drawable/background_tutorial_card"
        android:elevation="8dp">

        <TextView
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/badge"
            android:textSize="@dimen/text_size_list_item_text_small"
            tools:text="2 / 9"/>

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_vertical_small"
            android:paddingEnd="@dimen/margin_horizontal_small"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:textSize="@dimen/text_size_list_item_text_big"
            tools:text="Library"/>

        <TextView
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_vertical_small"
            android:paddingEnd="@dimen/margin_horizontal_small"
            android:textColor="#DE000000"
            android:textSize="@dimen/text_size_list_item_text"
            tools:text="Ready-made configs to download."/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_vertical_small"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_skip"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tutorial_skip"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/btn_back"
                style="@style/Widget.AppCompat.Button.Borderless.Colored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tutorial_back"/>

            <Button
                android:id="@+id/btn_next"
                style="@style/Widget.AppCompat.Button.Borderless.Colored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tutorial_next"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
