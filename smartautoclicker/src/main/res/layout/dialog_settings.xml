<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/dialog_width"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/margin_horizontal_default"
    android:paddingEnd="@dimen/margin_horizontal_default"
    android:paddingTop="@dimen/margin_vertical_default">

    <CheckBox
        android:id="@+id/check_adb_enabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_settings_adb_enabled" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_vertical_default"
        android:text="@string/dialog_settings_bridge_title"
        style="@style/HeaderTitle"/>

    <EditText
        android:id="@+id/edit_bridge_host"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_height"
        android:inputType="textUri"
        android:hint="@string/dialog_action_config_adb_host_title"
        android:importantForAutofill="no" />

    <EditText
        android:id="@+id/edit_bridge_port"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_height"
        android:inputType="number"
        android:hint="@string/dialog_action_config_adb_port_title"
        android:importantForAutofill="no" />

    <EditText
        android:id="@+id/edit_bridge_token"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_height"
        android:inputType="text"
        android:hint="@string/dialog_action_config_adb_token_title"
        android:importantForAutofill="no" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_vertical_default"
        android:text="@string/dialog_settings_library_title"
        style="@style/HeaderTitle"/>

    <EditText
        android:id="@+id/edit_library_url"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_height"
        android:inputType="textUri"
        android:hint="@string/dialog_settings_library_title"
        android:importantForAutofill="no" />

    <CheckBox
        android:id="@+id/check_notifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_vertical_small"
        android:layout_marginBottom="@dimen/margin_vertical_default"
        android:text="@string/dialog_settings_notifications" />

</LinearLayout>
